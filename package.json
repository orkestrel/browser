{
	"name": "@orkestrel/browser",
	"version": "0.0.20",
	"description": "Chrome DevTools Protocol browser automation with an environment-agnostic core. Part of the @orkestrel line.",
	"keywords": [
		"automation",
		"browser",
		"cdp",
		"chrome",
		"chromium",
		"devtools",
		"orkestrel",
		"screenshot",
		"typescript"
	],
	"homepage": "https://github.com/orkestrel/browser#readme",
	"bugs": "https://github.com/orkestrel/browser/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/orkestrel/browser.git"
	},
	"bin": {
		"browse": "dist/bin/main.js"
	},
	"files": [
		"dist/src",
		"dist/bin",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/src/core/index.cjs",
	"module": "./dist/src/core/index.js",
	"exports": {
		".": {
			"import": {
				"types": "./dist/src/core/index.d.ts",
				"default": "./dist/src/core/index.js"
			},
			"require": {
				"types": "./dist/src/core/index.d.cts",
				"default": "./dist/src/core/index.cjs"
			}
		},
		"./server": {
			"import": {
				"types": "./dist/src/server/index.d.ts",
				"default": "./dist/src/server/index.js"
			},
			"require": {
				"types": "./dist/src/server/index.d.cts",
				"default": "./dist/src/server/index.cjs"
			}
		},
		"./browser": {
			"types": "./dist/src/browser/index.d.ts",
			"default": "./dist/src/browser/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"copy": "node -e \"const fs=require('node:fs'),p=require('node:path'),a=process.argv[1],b=process.argv[2];fs.mkdirSync(p.dirname(b),{recursive:true});fs.cpSync(a,b,{force:true});console.log('Copied: '+a+' to '+b)\"",
		"scaffold": "scaffold",
		"lint": "oxlint --config .oxlintrc.json --fix .",
		"check": "tsc --noEmit --project tsconfig.json && npm run check:src",
		"check:src": "npm run check:src:core && npm run check:src:server && npm run check:src:browser && npm run check:src:bin",
		"check:src:core": "tsc --noEmit -p configs/src/tsconfig.core.json",
		"check:src:server": "tsc --noEmit -p configs/src/tsconfig.server.json",
		"check:src:browser": "tsc --noEmit -p configs/src/tsconfig.browser.json",
		"check:src:bin": "tsc --noEmit -p configs/src/tsconfig.bin.json",
		"format": "oxfmt --config .oxfmtrc.json --write .",
		"format:check": "oxfmt --config .oxfmtrc.json --check .",
		"lint:check": "oxlint --config .oxlintrc.json --deny-warnings .",
		"test": "npm run test:src && npm run test:src:bin && npm run test:policy && npm run test:config && npm run test:setup && npm run test:setup:browser && npm run test:guides && npm run test:conformance",
		"test:conformance": "vitest run --config vite.config.ts --no-cache --reporter=dot --project conformance",
		"test:src": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:core --project src:server --project src:browser",
		"test:src:core": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:core",
		"test:src:server": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:server",
		"test:src:browser": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:browser",
		"test:src:bin": "vitest run --config vite.config.ts --no-cache --reporter=dot --project src:bin",
		"test:policy": "vitest run --config vite.config.ts --no-cache --reporter=dot --project policy",
		"test:config": "vitest run --config vite.config.ts --no-cache --reporter=dot --project config",
		"test:guides": "node --experimental-strip-types tests/guides.test.ts",
		"build": "npm run clean && npm run build:src",
		"build:src": "npm run build:src:core && npm run build:src:server && npm run build:src:browser && npm run build:src:bin",
		"build:src:core": "vite build --config configs/src/vite.core.config.ts && npm run copy dist/src/core/index.d.ts dist/src/core/index.d.cts",
		"build:src:server": "vite build --config configs/src/vite.server.config.ts && npm run copy dist/src/server/index.d.ts dist/src/server/index.d.cts",
		"build:src:browser": "vite build --config configs/src/vite.browser.config.ts",
		"build:src:bin": "vite build --config configs/src/vite.bin.config.ts",
		"prepack": "npm run build",
		"prepublishOnly": "npm run format:check && npm run lint:check && npm run check && npm run build && npm test && npm run test:distribution -- --mode release && npm run test:service",
		"test:distribution": "vitest run --config vite.config.ts --no-cache --reporter=dot --project distribution",
		"test:service": "vitest run --config vite.config.ts --no-cache --reporter=dot --project service",
		"test:probe": "vitest run --config vite.config.ts --no-cache --reporter=verbose --project probe",
		"test:bench": "vitest bench --config vite.config.ts --no-cache --project probe",
		"test:setup": "vitest run --config vite.config.ts --no-cache --reporter=dot --project setup",
		"test:setup:browser": "vitest run --config vite.config.ts --no-cache --reporter=dot --project setup:browser"
	},
	"dependencies": {
		"@orkestrel/contract": "^0.0.19",
		"@orkestrel/emitter": "^0.0.11",
		"@orkestrel/html": "^0.0.12",
		"@orkestrel/markdown": "^0.0.17",
		"@orkestrel/mcp": "^0.0.35",
		"@orkestrel/router": "^0.0.16",
		"@orkestrel/server": "^0.0.22",
		"@orkestrel/tool": "^0.0.18",
		"@orkestrel/websocket": "^0.0.14"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.59.3",
		"@orkestrel/guide": "^0.0.22",
		"@orkestrel/probe": "^0.0.19",
		"@orkestrel/scaffold": "^0.0.82",
		"@orkestrel/test": "^0.0.24",
		"@types/node": "^26.6.3",
		"@vitest/browser-playwright": "^4.1.11",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"playwright": "^1.63.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
